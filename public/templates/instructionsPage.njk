func (inst *{{ instruction.name | pascalCase }}) GetAccounts() (out []*ag_solanago.AccountMeta) {
	out = make([]*ag_solanago.AccountMeta, 0, len(inst.AccountMetaSlice))
	for i, meta := range inst.AccountMetaSlice {
{% if optionalAccountIndexes.length == 1 %}
		if meta == nil && i == {{ optionalAccountIndexes[0] }} {
{% if optionalAccountStrategy == 'omitted' %}
			continue
{% else %}
			meta = ag_solanago.Meta(ProgramID)
{% endif %}
		}
{% else %}
		if meta == nil {
			switch i {
			case {{ optionalAccountIndexes | join(', ') }}:
{% if optionalAccountStrategy == 'omitted' %}
				continue
{% else %}
				meta = ag_solanago.Meta(ProgramID)
{% endif %}
			}
		}
{% endif %}
		out = append(out, meta)
	}
	return out
}
{% else %}
func (inst *{{ instruction.name | pascalCase }}) GetAccounts() (out []*ag_solanago.AccountMeta) {
	out = make([]*ag_solanago.AccountMeta, len(inst.AccountMetaSlice))
	copy(out, inst.AccountMetaSlice)
