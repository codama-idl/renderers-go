// GetAccounts returns the account metas in instruction order, including any
// remaining accounts appended to AccountMetaSlice.
{% if optionalAccountIndexes.length > 0 %}
{% if optionalAccountStrategy == 'omitted' %}
// Unset optional accounts are left out.
{% else %}
// Unset optional accounts are passed as the program id, as the program expects.
