{% extends "layout.njk" %}
{% block main %}

import (
	"bytes"
	"fmt"

	ag_binary "github.com/gagliardetto/binary"
	ag_solanago "github.com/gagliardetto/solana-go"
)

// ProgramName is the name of the program this package was generated for.
const ProgramName = "{{ programsToExport[0].name | pascalCase }}"

// ProgramID is the address of the program. Override it with SetProgramID.
var ProgramID = ag_solanago.MustPublicKeyFromBase58("{{ programsToExport[0].publicKey }}")

// SetProgramID overrides ProgramID and registers the instruction decoder for
// it. Call it once during initialization, before any concurrent use of this
// package: ProgramID is read by instruction builders and PDA helpers without
// synchronization. It fails when a different decoder is already registered
// for pubkey.
func SetProgramID(pubkey ag_solanago.PublicKey) error {
	ProgramID = pubkey
	return ag_solanago.RegisterInstructionDecoder(ProgramID, registryDecodeInstruction)
}

// The decoder is registered for the default ProgramID at package init so
// ag_solanago.DecodeInstruction works without calling SetProgramID. The first
// decoder registered for a program id wins; a failure here means another
// package already decodes this program.
func init() {
	_ = ag_solanago.RegisterInstructionDecoder(ProgramID, registryDecodeInstruction)
}

// Instruction_{{ instructionsToExport | length }}_Count is the number of instructions the program exposes.
const Instruction_{{ instructionsToExport | length }}_Count uint32 = {{ instructionsToExport | length }}

// Instruction wraps one of the generated instruction types (Impl, always a
// pointer) together with its discriminator (TypeID). It implements
// ag_solanago.Instruction.
type Instruction struct {
	ag_binary.BaseVariant
}

// ProgramID returns the program the instruction is addressed to.
func (inst *Instruction) ProgramID() ag_solanago.PublicKey {
	return ProgramID
}

// Accounts returns the account metas of the wrapped instruction, or nil when
// Impl is not a generated instruction.
func (inst *Instruction) Accounts() (out []*ag_solanago.AccountMeta) {
	if v, ok := inst.Impl.(ag_solanago.AccountsGettable); ok {
		return v.GetAccounts()
	}
	return nil
}

// Data returns the serialized instruction data.
func (inst *Instruction) Data() ([]byte, error) {
	buf := new(bytes.Buffer)
	if err := ag_binary.NewBorshEncoder(buf).Encode(inst); err != nil {
		return nil, fmt.Errorf("unable to encode instruction: %w", err)
	}
	return buf.Bytes(), nil
}

// MarshalWithEncoder writes the instruction data: the discriminator, when the
// instruction has one, followed by its arguments.
func (inst *Instruction) MarshalWithEncoder(encoder *ag_binary.Encoder) error {
	impl, ok := inst.Impl.(ag_binary.BinaryMarshaler)
	if !ok {
		return fmt.Errorf("instruction impl %T must be a pointer to a generated instruction", inst.Impl)
	}
	return impl.MarshalWithEncoder(encoder)
}

// hasDiscriminator reports whether the unread decoder bytes carry want at the
// given byte offset.
func hasDiscriminator(decoder *ag_binary.Decoder, offset int, want []byte) bool {
	got, err := decoder.Peek(offset + len(want))
	return err == nil && bytes.Equal(got[offset:], want)
}

// UnmarshalWithDecoder dispatches on the leading discriminator bytes declared
// in the IDL and decodes the matching instruction.
func (inst *Instruction) UnmarshalWithDecoder(decoder *ag_binary.Decoder) error {
{% if singleUndiscriminatedInstruction %}
	impl := new({{ singleUndiscriminatedInstruction.name | pascalCase }})
	typeID := ag_binary.NoTypeIDDefaultID
{% else %}
	var impl any
	var typeID ag_binary.TypeID
	switch {
{% for instruction in decodableInstructions %}
	case hasDiscriminator(decoder, {{ instruction.offset }}, {{ instruction.varName }}):
		impl = new({{ instruction.name | pascalCase }})
		typeID = ag_binary.TypeIDFromBytes({{ instruction.varName }})
{% endfor %}
	default:
		prefix, _ := decoder.Peek(min(8, decoder.Remaining()))
		return fmt.Errorf("unknown instruction discriminator %x", prefix)
	}
{% endif %}
	if err := decoder.Decode(impl); err != nil {
		return err
	}
	inst.TypeID = typeID
	inst.Impl = impl
	return nil
}

func registryDecodeInstruction(accounts []*ag_solanago.AccountMeta, data []byte) (any, error) {
	inst, err := DecodeInstruction(accounts, data)
	if err != nil {
		return nil, err
	}
	return inst, nil
}

// DecodeInstruction decodes instruction data and binds the given account
// metas to the decoded instruction.
func DecodeInstruction(accounts []*ag_solanago.AccountMeta, data []byte) (*Instruction, error) {
	inst := new(Instruction)
	if err := ag_binary.NewBorshDecoder(data).Decode(inst); err != nil {
		return nil, fmt.Errorf("unable to decode instruction: %w", err)
	}
	if v, ok := inst.Impl.(ag_solanago.AccountsSettable); ok {
		if err := v.SetAccounts(accounts); err != nil {
			return nil, fmt.Errorf("unable to set accounts for instruction: %w", err)
		}
	}
	return inst, nil
}

{% endblock %}
