// SetAccounts binds decoded account metas to the instruction. Missing
// optional accounts are padded with nil; extra (remaining) accounts are kept.
func (inst *{{ instruction.name | pascalCase }}) SetAccounts(accounts []*ag_solanago.AccountMeta) error {
{% if minRequiredAccounts > 0 %}
	if len(accounts) < {{ minRequiredAccounts }} {
		return fmt.Errorf("not enough accounts: expected at least {{ minRequiredAccounts }}, got %d", len(accounts))
	}
{% endif %}
{% if minRequiredAccounts < instruction.accounts.length %}
	if len(accounts) < {{ instruction.accounts.length }} {
		padded := make(ag_solanago.AccountMetaSlice, {{ instruction.accounts.length }})
		copy(padded, accounts)
		accounts = padded
	}
{% endif %}
	inst.AccountMetaSlice = accounts
	return nil
}

