		return err
	}
{% elif arg.default %}
	if err := encoder.Encode({{ arg.type }}({{ arg.value }})); err != nil {
		return err
	}
{% elif arg.innerOptionType %}
	if inst.{{ arg.name | pascalCase }} == nil {
		if err := encoder.WriteBool(false); err != nil {
			return err
		}
	} else {
		if err := encoder.WriteBool(true); err != nil {
			return err
		}
		if err := encoder.Encode(*inst.{{ arg.name | pascalCase }}); err != nil {
			return err
		}
	}
{% elif arg.remainder == 'string' %}
	if err := encoder.WriteBytes([]byte(inst.{{ arg.name | pascalCase }}), false); err != nil {
		return err
	}
{% elif arg.remainder == 'bytes' %}
	if err := encoder.WriteBytes(inst.{{ arg.name | pascalCase }}, false); err != nil {
		return err
	}
{% elif arg.remainder == 'array' %}
	for _, item := range inst.{{ arg.name | pascalCase }} {
		if err := encoder.Encode(item); err != nil {
			return err
		}
	}
{% else %}
	if err := encoder.Encode(inst.{{ arg.name | pascalCase }}); err != nil {
		return err
	}
{% endif %}
{% endfor %}
	return nil
}

